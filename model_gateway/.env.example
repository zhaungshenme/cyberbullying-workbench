# Server-only reference configuration; gateway.py does not load .env files.
# Supply these through your process manager or environment before launching.
# Replace the explicit private IPv4 addresses with your inference interface and
# the business server's actual connection source as seen by this gateway.
CB_GATEWAY_BIND_ADDRESS=192.168.0.1
CB_GATEWAY_CLIENT_ADDRESS=192.168.0.129
CB_GATEWAY_PORT=8444

# TLS certificate SAN must match the hostname/IP in CB_MODEL_GATEWAY_URL.
CB_GATEWAY_TLS_CERT=/etc/workbench/tls/gateway.crt
CB_GATEWAY_TLS_KEY=/etc/workbench/tls/gateway.key

# Generate a distinct random secret of at least 32 non-whitespace characters.
CB_MODEL_GATEWAY_TOKEN=

# Required pinned reference artifacts; no automatic model download/import.
CB_TOKENIZER_DIR=/srv/workbench/models/qwen3-4b/tokenizer
CB_TOKENIZER_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
CB_MODEL_FILE_PATH=/srv/workbench/models/qwen3-4b/model.gguf
CB_MODEL_REVISION=sha256:7485fe6f11af29433bc51cab58009521f205840f5b4ae3a32fa7f92e8534fdf5
# Required Ollama manifest digest obtained after verified alias import.
# This is distinct from the GGUF file SHA256 and is not an API credential.
CB_MODEL_OLLAMA_DIGEST=
