# Server-only. Never use NEXT_PUBLIC_* for credentials.
WORKBENCH_BACKEND_URL=http://127.0.0.1:18788
WORKBENCH_BACKEND_TOKEN=
# Account credentials and revocable sessions are managed by the backend auth database.
# true for HTTPS. Use false only for an isolated HTTP development demo.
WORKBENCH_COOKIE_SECURE=true
PORT=3001
HOSTNAME=0.0.0.0
