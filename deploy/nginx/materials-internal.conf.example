# Example only. Replace interface, domain, Dify network and certificates.
# Firewall must restrict this port to the actual Dify execution network.
server {
    listen 10.0.10.20:18789 ssl;
    server_name materials.internal.example.org;
    ssl_certificate /etc/workbench/tls/materials.crt;
    ssl_certificate_key /etc/workbench/tls/materials.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 10.0.20.0/24;
    deny all;
    client_max_body_size 16k;
    access_log off;
    location = /integration/health {
        proxy_pass http://127.0.0.1:18788;
        proxy_set_header Authorization $http_authorization;
    }
    location = /integration/analysis-jobs {
        proxy_pass http://127.0.0.1:18788;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
